# --- Local engines ---
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE=int8
MLX_WHISPER_CONDITION_ON_PREVIOUS_TEXT=true   # false breaks repetition loops on long files
PARAKEET_CHUNK_SECONDS=120                    # longer files are split into chunks
PARAKEET_OVERLAP_SECONDS=15

# --- HuggingFace (optional: faster / higher-rate model downloads) ---
HF_TOKEN=

# --- Eval: S3 source audio (only for s3:// entries in a manifest) ---
# S3_ENDPOINT_URL=                  # S3-compatible endpoint (R2 / MinIO / ...); unset for AWS
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Eval: MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT=stt-eval
